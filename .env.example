WAIT_HISTORY=10
FALLBACK_MINUTES=
CROWD_THRESHOLDS=moderate:20/6,high:45/12,critical:90/20
# Optional services
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
